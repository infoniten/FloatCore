# Код драйвера I²C — в IRAM (ТЗ v0.9I §9, §15).
#
# Зачем. Измерено: собственный процессор одного вызова чтения датчика на
# ядре 1 — около 480 мкс, а тот же код на спокойном ядре 0 — около 180 мкс
# (развёртка по длине чтения, свободный член за вычетом провода). Код один,
# функция одна; различается только то, что лежит в кэше инструкций ядра.
# У каждого ядра ESP32 свой кэш на 32 КБ, и на ядре 1 между вызовами код
# драйвера вытесняют Refloat и AHRS.
#
# Код в IRAM исполняется без кэша. Цена — около 25 КБ из свободных 71 КБ IRAM.
#
# Помещается ВЕСЬ драйвер, а не отдельные функции: путь вызова проходит через
# десятки внутренних функций, и вынос части оставил бы промахи в остальных.

[mapping:fc_i2c_driver_iram]
archive: libesp_driver_i2c.a
entries:
    * (noflash)

[mapping:fc_i2c_hal_iram]
archive: libhal.a
entries:
    i2c_hal (noflash)
    i2c_hal_iram (noflash)
